# Copie este arquivo para .env e preencha com os valores do seu projeto Supabase.
#
# Project URL: Project Settings > Integrations > Data API
# Chave: Project Settings > API Keys > "Publishable key" (sb_publishable_...)
#
# VITE_SUPABASE_ANON_KEY é uma chave PÚBLICA — pode ficar no frontend.
# A Secret key (sb_secret_..., antigo service_role) NUNCA deve entrar
# aqui nem em nenhum arquivo que vá para o navegador.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
